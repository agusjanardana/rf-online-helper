# Supabase is used as a database only. No Supabase Auth or SMTP configuration.
# Project API URL, NOT the postgresql:// database connection string.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only: Supabase Settings > API > service_role (or a server secret key).
# NEVER prefix this key with NEXT_PUBLIC_ or include it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
